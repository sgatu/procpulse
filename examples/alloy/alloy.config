logging {
	level = "info"
}

// ==============================================================================
// Grafana Alloy Configuration for ProcPulse
//
// This configuration:
// 1. Tails the ProcPulse CSV file on this machine.
// 2. Extracts CPU, Working Set, Commit Bytes, and Active Private Memory.
// 3. Pushes metrics to Grafana Cloud Hosted Prometheus.
// 4. Automatically tags all metrics with this machine's Windows COMPUTERNAME.
// 5. Streams the raw log lines to Grafana Cloud Hosted Loki.
// ==============================================================================

// 1. Locate and watch the ProcPulse CSV file (use forward slashes)
local.file_match "procpulse_csv" {
  path_targets = [{
    __path__ = "C:/procpulse/procpulse_metrics.csv",
    job      = "procpulse",
    machine  = coalesce(env("COMPUTERNAME"), env("HOSTNAME"), "localhost"),
  }]
  sync_period = "60s"
}

// 2. Stream new lines as they are appended to the CSV
loki.source.file "procpulse_source" {
  targets       = local.file_match.procpulse_csv.targets
  forward_to    = [loki.process.procpulse_parser.receiver]
  tail_from_end = false
}

// 3. Parse CSV columns and extract Prometheus metrics
loki.process "procpulse_parser" {
  // Extract all 19 CSV columns into named fields using regex (handles quoted or unquoted args)
  stage.regex {
    expression = "^(?P<timestamp>[^,]+),(?P<executable>[^,]+),(?P<args>\"(?:[^\"]|\"\")*\"|[^,]*),(?P<pid>[^,]+),(?P<app_cpu_avg>[^,]+),(?P<app_cpu_peak>[^,]+),(?P<app_cpu_cycles>[^,]+),(?P<app_cpu_time_ms>[^,]+),(?P<app_ram_mb_avg>[^,]+),(?P<app_ram_mb_peak>[^,]+),(?P<app_priv_ram_mb_avg>[^,]+),(?P<app_priv_ram_mb_peak>[^,]+),(?P<app_priv_active_mb_avg>[^,]+),(?P<app_priv_active_mb_peak>[^,]+),(?P<system_cpu_avg>[^,]+),(?P<system_cpu_peak>[^,]+),(?P<system_ram_mb_avg>[^,]+),(?P<system_ram_mb_peak>[^,]+),(?P<samples>[^,\r\n]+)"
  }

  // Drop the first header row if it is read
  stage.drop {
    source = "timestamp"
    value  = "timestamp"
  }

  // Attach instance differentiator labels (e.g. daemon vs session)
  stage.labels {
    values = {
      args       = "args",
      executable = "executable",
    }
  }

  // Generate Prometheus Gauges from the parsed CSV values
  stage.metrics {
    metric.gauge {
      name        = "procpulse_app_priv_active_mb"
      description = "Active private memory in MB (Task Manager Processes tab)"
      source      = "app_priv_active_mb_avg"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_app_priv_ram_mb"
      description = "Commit private bytes in MB (Total allocated memory)"
      source      = "app_priv_ram_mb_avg"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_app_ram_ws_mb"
      description = "Total resident working set memory in MB"
      source      = "app_ram_mb_avg"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_app_cpu_percent"
      description = "Application CPU percent of total machine"
      source      = "app_cpu_avg"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_app_cpu_cycles"
      description = "Total CPU cycles consumed in aggregation window"
      source      = "app_cpu_cycles"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_app_cpu_time_ms"
      description = "Total process CPU time in milliseconds consumed in aggregation window"
      source      = "app_cpu_time_ms"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_system_cpu_percent"
      description = "Total system CPU percent"
      source      = "system_cpu_avg"
      action      = "set"
    }

    metric.gauge {
      name        = "procpulse_system_ram_used_mb"
      description = "Total system physical RAM used in MB"
      source      = "system_ram_mb_avg"
      action      = "set"
    }
  }

  // Forward the raw log entries to Hosted Loki
  forward_to = [loki.write.grafana_loki.receiver]
}

// 4. Scrape the extracted metrics into Prometheus format
prometheus.scrape "alloy_internal" {
  targets = [
    { "__address__" = "127.0.0.1:12345" }, // Alloy internal telemetry listener
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.hosted_prometheus.receiver]
}

// 5. Remote-write metrics to Grafana Cloud Hosted Prometheus
prometheus.remote_write "hosted_prometheus" {
  endpoint {
    name = "hosted-prometheus"
    url  = "https://<prometheus>.grafana.net/api/prom/push"

    basic_auth {
      username = "<username>"
      password = "<password>"
    }
  }

  // Automatically labels all metrics with this computer's Windows hostname
  external_labels = {
    machine = coalesce(env("COMPUTERNAME"), env("HOSTNAME"), "unknown"),
  }
}

// 6. Push raw logs to Grafana Cloud Hosted Loki
loki.write "grafana_loki" {
  endpoint {
    url = "https://<loki>.grafana.net/loki/api/v1/push"

    basic_auth {
      username = "<username>"
      password = "<password>"
    }
  }
}
